# AI-GMAIL environment configuration template
# ---------------------------------------------------------------
# Copy this file to `.env` and fill in REAL values. NEVER commit `.env`.
# `.env` is gitignored; this example file contains PLACEHOLDERS ONLY.
#
# These values are injected into BuildConfig at build time by the
# Secrets Gradle Plugin (see app/build.gradle.kts -> secrets { }).
# The Firebase Android API key is a public client identifier for
# Firebase services — it is NOT the Gemini API key. The Gemini key
# lives ONLY on the authenticated backend server.

# Firebase (from Firebase Console -> Project Settings -> General -> Your apps)
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_APPLICATION_ID=YOUR_FIREBASE_APPLICATION_ID

# OAuth Web Client ID used for Google Sign-In
# (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, type "Web application")
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID

# Base URL of the authenticated AI backend proxy (must be HTTPS)
# This is the backend that holds the Gemini API key and verifies Firebase ID tokens.
AI_BACKEND_URL=https://YOUR-AI-BACKEND-DOMAIN/

# Optional: Firebase App Check (reCAPTCHA Enterprise provider).
# Site key from Google Cloud Console -> reCAPTCHA Enterprise (a public site key,
# not a secret). If left as a placeholder, App Check is skipped at app start.
RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY

# Optional: App Check debug token for local development only.
# NEVER commit a real value; this property is excluded from BuildConfig
# via the secrets plugin ignoreList and must stay a placeholder here.
FIREBASE_APPCHECK_DEBUG_TOKEN=YOUR_APPCHECK_DEBUG_TOKEN
