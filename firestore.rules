rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // SEC-015: privileged-field guardrail.
    // A client write may only touch the documented fields for its collection.
    // This stops a compromised client (or a curious user with the API) from
    // self-escalating — e.g. writing an `isAdmin`, `role`, or `subscriptionTier`
    // field onto their own documents. The allowed key lists mirror exactly
    // what `FirestoreService.kt` writes.
    function writesOnlyAllowedKeys(allowedKeys) {
      return request.method == 'delete' ||
             request.resource.data.keys().hasOnly(allowedKeys);
    }

    // Explicitly reject root or un-namespaced access
    match /{document=**} {
      allow read, write: if false;
    }

    // User-specific data isolation
    match /users/{userId} {
      // The user profile document itself is READ-ONLY for clients.
      // The app only ever writes to the subcollections below; nothing else
      // may create or modify the profile document from a client.
      allow read: if isOwner(userId);
      allow write: if false;

      // Campaigns subcollection
      match /campaigns/{campaignId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && writesOnlyAllowedKeys([
          'id', 'title', 'targetName', 'targetCompany', 'targetRole', 'framework',
          'subjectVariantA', 'subjectVariantB', 'body', 'followUp1',
          'valueProposition', 'callToAction', 'tone', 'deliverabilityScore',
          'createdAt', 'updatedAt'
        ]);
      }

      // Automation Rules subcollection
      match /automation_rules/{ruleId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && writesOnlyAllowedKeys([
          'id', 'name', 'description', 'triggerType', 'triggerCondition',
          'actionType', 'actionParameter', 'isEnabled', 'executionCount',
          'lastRunTimestamp', 'updatedAt'
        ]);
      }

      // Social Outreach subcollection
      match /social_outreach/{outreachId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && writesOnlyAllowedKeys([
          'id', 'platform', 'targetPersonOrChannel', 'messageText',
          'outreachType', 'timestamp', 'isSent'
        ]);
      }

      // Scheduled Emails subcollection
      match /scheduled_emails/{scheduledId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && writesOnlyAllowedKeys([
          'id', 'recipientTo', 'recipientCc', 'subject', 'body',
          'scheduledTimeEpoch', 'scheduledTimeFormatted', 'status',
          'createdAt', 'updatedAt'
        ]);
      }

      // User Settings subcollection
      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && writesOnlyAllowedKeys([
          'notifyUrgent', 'notifyWork', 'notifyPersonal', 'notifyInvestors',
          'notifyPromotions', 'notifySocial', 'quietHoursEnabled',
          'quietHoursStart', 'quietHoursEnd', 'updatedAt'
        ]);
      }
    }
  }
}
